# Database Configuration
DATABASE_URL=postgresql+asyncpg://clipfactory:clipfactory@localhost:5432/clipfactory

# Database Pool Configuration
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Database Debug
DB_ECHO=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# File Upload Limits
MAX_VIDEO_SIZE=53687091200  # 50GB in bytes
MAX_IMAGE_SIZE=10485760     # 10MB in bytes

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=INFO
